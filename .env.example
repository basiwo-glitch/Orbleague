# ---- Pflicht ----
DASHBOARD_PASSWORD=bitte-ein-langes-passwort
PUBLIC_URL=https://orbleague.deinedomain.de
TIMEZONE=Europe/Berlin

# ---- TikTok (developers.tiktok.com -> deine App -> Keys) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# muss exakt so in der TikTok-App als Redirect URI eingetragen sein:
# TIKTOK_REDIRECT_URI=https://orbleague.deinedomain.de/auth/callback

# ---- Claude API (optional, verbessert Captions/Strategie; ohne Key laufen Vorlagen) ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# USD je 1 Mio Tokens – mit aktueller Preisliste abgleichen
LLM_PRICE_IN_PER_MTOK=1.0
LLM_PRICE_OUT_PER_MTOK=5.0
LLM_DAILY_BUDGET_USD=0.50
SERVER_COST_MONTHLY_USD=6

# ---- Startwerte (später im Dashboard änderbar) ----
POSTS_PER_DAY=3
POST_TIMES=13:05,18:35,21:10
PUBLISH_MODE=inbox
DIRECT_PRIVACY=SELF_ONLY
AUTO_APPROVE=0
